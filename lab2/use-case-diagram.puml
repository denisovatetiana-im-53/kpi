
@startuml
left to right direction
skinparam packageStyle rectangle

actor "Користувач системи" as User
actor "Покупець" as Buyer
actor "Адміністратор" as Admin
actor "Платіжний сервіс" as PaymentService

User <|-- Buyer
User <|-- Admin

rectangle "Онлайн-магазин" {
  usecase "Переглянути каталог" as UC1
  usecase "Створити замовлення" as UC2
  usecase "Перевірити дані\nзамовлення" as UC3
  usecase "Оплатити замовлення" as UC4
  usecase "Обробити платіж" as UC5
  usecase "Повторити оплату" as UC6
  usecase "Керувати товарами" as UC7
  usecase "Керувати категоріями" as UC8
}

Buyer --> UC1
Buyer --> UC2
Buyer --> UC4
Buyer --> UC6

UC2 ..> UC3 : <<include>>
UC4 ..> UC5 : <<include>>
UC6 ..> UC4 : <<extend>> [попередня спроба оплати невдала]

PaymentService --> UC5
Admin --> UC7
Admin --> UC8

@enduml

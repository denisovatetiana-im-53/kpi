
@startuml
left to right direction
skinparam packageStyle rectangle

actor "Покупець" as Buyer
actor "Адміністратор" as Admin
actor "Платіжний сервіс" as PaymentService

rectangle "Онлайн-магазин" {
  usecase "UC-01\nПереглянути каталог" as UC1
  usecase "UC-02\nСтворити замовлення" as UC2
  usecase "UC-03\nПеревірити дані замовлення" as UC3
  usecase "UC-04\nОплатити замовлення" as UC4
  usecase "UC-05\nОтримати результат платежу" as UC5
  usecase "UC-06\nПовторити оплату" as UC6
  usecase "UC-07\nКерувати товарами" as UC7
  usecase "UC-08\nКерувати категоріями" as UC8
  usecase "UC-09\nПереглянути результат оплати" as UC9
}

Buyer --> UC1
Buyer --> UC2
Buyer --> UC4
Buyer --> UC6
Buyer --> UC9

UC2 ..> UC3 : <<include>>
UC4 ..> UC5 : <<include>>
UC6 ..> UC4 : <<extend>>\n[попередня спроба невдала]

PaymentService --> UC5
Admin --> UC7
Admin --> UC8

@enduml
